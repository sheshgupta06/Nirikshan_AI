# ==============================================================================
# NIRIKSHAN AI — Environment Configuration Template
# ==============================================================================
# Duplicate this file as .env and replace placeholders with your credentials.
# Get these values from: https://supabase.com/dashboard -> Project Settings -> API / Database
# ==============================================================================

# Supabase Project Configuration (Frontend & Backend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase PostgreSQL Direct Database Connection (Backend SQLAlchemy)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Service Role Secret Key (Optional - for backend admin bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Nirikshan AI FastAPI Backend Port & Host
API_HOST=0.0.0.0
API_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000
